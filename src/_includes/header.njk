<header class="site-header">
    <div class="site-header-inner">
        <a class="brand-link" href="/">
            <img class="brand-mark" src="/static/frog_logo.png" alt="">
            <span class="brand-copy">
                <strong class="brand-name">Data Frog</strong>
                <small class="brand-tagline">Field notes in data and Python</small>
            </span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
            <a href="/curriculum/"{% if page.url == "/curriculum/" or "/curriculum" in page.url %} class="active" aria-current="page"{% endif %}>Curriculum</a>
            <a href="/algorithms/"{% if "/algorithms" in page.url %} class="active" aria-current="page"{% endif %}>Algorithms</a>
            <a href="/data-wrangling/"{% if "/data-wrangling" in page.url %} class="active" aria-current="page"{% endif %}>Data Wrangling</a>
            <a href="/statistics/"{% if "/statistics" in page.url %} class="active" aria-current="page"{% endif %}>Statistics</a>
            <a href="/videos/"{% if "/videos" in page.url %} class="active" aria-current="page"{% endif %}>Videos</a>
            <a href="/#data-sourcing"{% if page.url == "/" %} class="active" aria-current="page"{% endif %}>Data Sourcing</a>
        </nav>
    </div>
</header>
